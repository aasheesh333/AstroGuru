<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12+.
  Disables both cloud backup and device-to-device transfer of app data
  because the app stores sensitive information (chat history, profile image,
  cached AI responses) in SharedPreferences.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
