# AstroPrerna local-dev environment template.
#
# Copy this to `assets/.env` and edit for your local setup. The file is
# NOT bundled in the APK. The CI workflow injects real values via
# `flutter build --dart-define-from-file=<this>`.
#
# Only PUBLIC values go here (AdMob app/unit IDs, OneSignal app ID).
# The Gemini API key lives in Firestore under `gemini_api_keys/gemini_api_list`
# and is fetched at runtime by KeyManager. It NEVER ships in the APK.
#
# For LOCAL DEV ONLY you may override the Gemini key here so it is not
# fetched from Firestore on every cold start. Leave blank in CI/release.

APP_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
APP_ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
APP_ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
APP_ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917
APP_ONESIGNAL_APP_ID=
APP_ONESIGNAL_API_KEY=
APP_GEMINI_API_KEY=
