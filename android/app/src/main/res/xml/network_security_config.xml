<?xml version="1.0" encoding="utf-8"?>
<!--
  Production network security configuration.
  - Cleartext traffic disabled everywhere (no HTTP allowed).
  - Only TLS 1.2 and TLS 1.3 enabled.
  - System and user CAs trusted for certificate transparency.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
